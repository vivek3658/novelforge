# ==============================================================================
# Eureka Server - Production Environment Template (.env.production.example)
# Render Free Tier Specs: 0.1 vCPU / 512MB RAM
# ==============================================================================
PORT=8761
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms64m -Xmx160m -XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=32m -Xss256k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom
RENDER_SERVICE_NAME=novelforge-eureka-server
