  "cards": [
    { "dot": "cyan", "title": "Primary request path", "items": ["Browser uses the React client to call REST through Spring Cloud Gateway.", "Gateway rewrites /api/v1/identity and /api/v1/novels paths to their service APIs.", "Identity handles registration/login; novel service handles paginated catalog, search, and novel CRUD."] },
    { "dot": "emerald", "title": "Ownership and state", "items": ["Identity owns user data in the userDB database and uses Redis for short-lived OTP and verified-email state.", "Novel service owns novel data in the separate novelDB database; both databases currently share one PostgreSQL container in Compose.", "Services are deployed in a shared Docker Compose network; data stores are service-owned logical boundaries, not separate database servers."] },
    { "dot": "amber", "title": "External dependency and registry", "items": ["Notification service calls the external Brevo HTTPS API to deliver OTP email.", "Eureka is configured as the service registry; gateway and backend clients register against it in the deployment configuration.", "The committed Compose gateway routes default to hosted Render URLs unless service URL variables are overridden."] },
    { "dot": "rose", "title": "Scope and trust caveats", "items": ["Engagement, AI, analytics, and studio are present as scaffolds or in-progress code; they are not on the committed primary request path.", "The browser and gateway are the public-facing path; authentication and resource authorization are enforced by backend services.", "Current implementation review found hard-coded sample secrets and token/OTP logging; rotate/remove before production. Novel writes currently lack creator ownership checks."] }
