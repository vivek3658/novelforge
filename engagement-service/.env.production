# ==============================================================================
# Engagement Service - Production Environment Configuration for Render (0.1 vCPU / 512MB RAM)
# ==============================================================================
PORT=8084
SERVER_PORT=8084
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms96m -Xmx200m -XX:MaxMetaspaceSize=110m -XX:ReservedCodeCacheSize=48m -Xss256k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# Database (PostgreSQL - automatically converted to JDBC in Dockerfile entrypoint)
DATABASE_URL=postgresql://novelforge_user:password@novelforge-postgres:5432/engagementDB
SPRING_DATASOURCE_URL=jdbc:postgresql://novelforge-postgres:5432/engagementDB
SPRING_DATASOURCE_USERNAME=novelforge_user
SPRING_DATASOURCE_PASSWORD=replace_with_db_password
POSTGRES_USER=novelforge_user
POSTGRES_PASSWORD=replace_with_db_password

# Redis (Render Managed Key-Value Store)
REDIS_URL=redis://default:password@novelforge-redis:6379
SPRING_DATA_REDIS_HOST=novelforge-redis
SPRING_DATA_REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=novelforge-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=novelforge
RABBITMQ_PASSWORD=replace_with_rabbitmq_password

# Security & JWT
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_key_at_least_256_bits_long
NOVELFORGE_SECURITY_JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_key_at_least_256_bits_long

# Inter-Service Communication Endpoints & Secrets
STUDIO_SERVICE_BASE_URL=http://novelforge-studio-service:8087
IDENTITY_SERVICE_BASE_URL=http://novelforge-identity-service:8081
NOVEL_SERVICE_BASE_URL=http://novelforge-novel-service:8083
ENGAGEMENT_STUDIO_INTERNAL_SECRET=replace_with_engagement_to_studio_secret_32bytes_min
ENGAGEMENT_IDENTITY_INTERNAL_SECRET=replace_with_engagement_identity_secret_32bytes_min

# Service Discovery (Eureka)
EUREKA_CLIENT_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://novelforge-eureka-server:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
