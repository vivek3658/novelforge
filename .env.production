# ==============================================================================
# NovelForge Production Environment Configuration (.env.production)
# Optimized for Cloud Deployment on Render Free Tier (0.1 vCPU / 512MB RAM)
# ==============================================================================

# Active Spring Profile for All Services
SPRING_PROFILES_ACTIVE=prod

# JVM Tuning for 0.1 vCPU and 512MB RAM Containers
# Serial GC prevents CPU thrashing; memory caps prevent cgroup OOMKilled crashes.
JAVA_OPTS=-Xms96m -Xmx200m -XX:MaxMetaspaceSize=110m -XX:ReservedCodeCacheSize=48m -Xss256k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# ------------------------------------------------------------------------------
# 1. Managed Databases
# ------------------------------------------------------------------------------
# PostgreSQL (Managed Render Postgres or external provider)
POSTGRES_USER=novelforge_user
POSTGRES_PASSWORD=replace_with_strong_production_db_password
DATABASE_URL=postgresql://novelforge_user:replace_with_strong_production_db_password@novelforge-postgres:5432/novelforge

# MongoDB (Novel Chapter Blocks - MongoDB Atlas Free M0 or Render container)
SPRING_MONGODB_URI=mongodb+srv://novelforge:replace_password@cluster0.mongodb.net/novelforge_chapters?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://novelforge:replace_password@cluster0.mongodb.net/novelforge_chapters?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Redis Cache & Blacklist (Render Managed Key-Value Store)
# ------------------------------------------------------------------------------
REDIS_URL=redis://default:replace_with_redis_password@novelforge-redis:6379
SPRING_DATA_REDIS_HOST=novelforge-redis
SPRING_DATA_REDIS_PORT=6379
REDIS_HOST=novelforge-redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Message Broker (RabbitMQ / CloudAMQP)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=novelforge-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=novelforge
RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password

# ------------------------------------------------------------------------------
# 4. Security, JWT & HMAC Keys (Minimum 256-bit / 32 bytes)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=wilhelm.theresia.nasa.tsukasa.ayanokoji.subaru.production.key.change.me
NOVELFORGE_SECURITY_JWT_SECRET_KEY=wilhelm.theresia.nasa.tsukasa.ayanokoji.subaru.production.key.change.me
OTP_HMAC_SECRET=replace_with_a_secure_hmac_secret_key_minimum_32_characters_long
GATEWAY_INTERNAL_SECRET=replace_with_a_secure_gateway_internal_secret_32_chars_min
STUDIO_IDENTITY_INTERNAL_SECRET=replace_with_a_unique_studio_identity_secret_32_chars
ENGAGEMENT_IDENTITY_INTERNAL_SECRET=replace_with_a_unique_engagement_identity_secret_32_chars
NOTIFICATION_IDENTITY_INTERNAL_SECRET=replace_with_a_unique_notification_identity_secret_32_chars
NOVEL_STUDIO_INTERNAL_SECRET=replace_with_a_unique_novel_to_studio_secret_32_chars
ENGAGEMENT_STUDIO_INTERNAL_SECRET=replace_with_a_unique_engagement_to_studio_secret_32_chars
GATEWAY_TRUSTED_PROXY_HOPS=1
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 5. Email & Notification Delivery
# ------------------------------------------------------------------------------
NOTIFICATION_EMAIL_PROVIDER=brevo
BREVO_API_KEY=replace_with_your_brevo_api_key_xkeysib
BREVO_SENDER_EMAIL=notifications@yourdomain.com
NOTIFICATION_EMAIL_FROM=notifications@yourdomain.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_smtp_app_password

# ------------------------------------------------------------------------------
# 6. Service Discovery (Eureka Server)
# ------------------------------------------------------------------------------
EUREKA_CLIENT_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://novelforge-eureka-server:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true

# ------------------------------------------------------------------------------
# 7. Inter-Service Routing (Render Internal Network or Public HTTPS)
# ------------------------------------------------------------------------------
IDENTITY_SERVICE_URL=http://novelforge-identity-service:8081
IDENTITY_SERVICE_BASE_URL=http://novelforge-identity-service:8081
NOVEL_SERVICE_URL=http://novelforge-novel-service:8083
NOVEL_SERVICE_BASE_URL=http://novelforge-novel-service:8083
STUDIO_SERVICE_URL=http://novelforge-studio-service:8087
STUDIO_SERVICE_BASE_URL=http://novelforge-studio-service:8087
ENGAGEMENT_SERVICE_URL=http://novelforge-engagement-service:8084
NOTIFICATION_SERVICE_URL=http://novelforge-notification-service:8082

# ------------------------------------------------------------------------------
# 8. Frontend Client (novelforge-client)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://novelforge-api-gateway.onrender.com
VITE_API_URL=https://novelforge-api-gateway.onrender.com
VITE_IMAGEKIT_PUBLIC_KEY=public_novelforge_demo
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/novelforge
VITE_USE_MOCKS=false
