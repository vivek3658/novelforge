# =============================================================================
# NovelForge Web Client - Environment Configuration Example
# =============================================================================
#
# IMPORTANT SECURITY NOTES:
# 1. Any variable starting with VITE_ is public and embedded into client bundles.
#    NEVER put passwords, private keys, database credentials, or JWT signing secrets here.
# 2. All client API calls route exclusively through the API Gateway.
#    Do NOT configure direct microservice URLs or internal Eureka service discovery.
# =============================================================================

# Public API Gateway Base URL
# - Local Development: http://localhost:8080
# - Staging: https://api-gateway-staging.yourdomain.com
# - Production: https://api.yourdomain.com (or leave empty if using reverse-proxy / relative path)
VITE_API_BASE_URL=http://localhost:8080

# Optional: Public ImageKit Configuration (Client-side delivery only)
# Direct client uploads require a backend authentication endpoint (pending implementation).
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
VITE_IMAGEKIT_PUBLIC_KEY=public_your_imagekit_key
