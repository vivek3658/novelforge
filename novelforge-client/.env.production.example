# API backend endpoint (single entrypoint for all frontend API calls)
VITE_API_BASE_URL=https://novelforge-ngee.onrender.com
VITE_API_URL=https://novelforge-ngee.onrender.com
API_GATEWAY_URL=https://novelforge-ngee.onrender.com

# Direct Service URLs (Fallback/Direct access if needed)
VITE_IDENTITY_SERVICE_URL=https://novelforge-identity-service.onrender.com
VITE_NOVEL_SERVICE_URL=https://novelforge-novel-service.onrender.com
VITE_NOTIFICATION_SERVICE_URL=https://novelforge-notification-service.onrender.com
VITE_FRONTEND_URL=https://novelforge-client.onrender.com

# ImageKit Configuration (for avatar & novel cover uploads)
VITE_IMAGEKIT_PUBLIC_KEY=public_6U77zxZjNHdbLc+lPXqidIadcFk=
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/novelforge

# Disable Mock Data in Production
VITE_USE_MOCKS=false
