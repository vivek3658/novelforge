# ==============================================================================
# API Gateway - Production Environment Configuration for Render (0.1 vCPU / 512MB RAM)
# ==============================================================================
PORT=8080
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms96m -Xmx200m -XX:MaxMetaspaceSize=110m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=64m -Xss256k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Dio.netty.eventLoopThreads=2 -Dreactor.netty.ioWorkerCount=2 -Djava.security.egd=file:/dev/./urandom

# Service Routing URLs (Render Internal Network or Public HTTPS)
IDENTITY_SERVICE_URL=http://novelforge-identity-service:8081
NOVEL_SERVICE_URL=http://novelforge-novel-service:8083
STUDIO_SERVICE_URL=http://novelforge-studio-service:8087
ENGAGEMENT_SERVICE_URL=http://novelforge-engagement-service:8084

# Service Discovery (Eureka)
EUREKA_CLIENT_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://novelforge-eureka-server:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true

# Redis (Render Managed Key-Value Store)
REDIS_URL=redis://red-xxxxxxxx:6379
SPRING_DATA_REDIS_HOST=novelforge-redis
SPRING_DATA_REDIS_PORT=6379

# Gateway Security & Trusted Proxy Hops (Render uses 1 proxy hop)
GATEWAY_INTERNAL_SECRET=replace_with_a_secure_gateway_internal_secret_32bytes_min
GATEWAY_TRUSTED_PROXY_HOPS=1
