# ==============================================================================
# NovelForge Environment Configuration Template (.env.example)
# Copy this file to .env and supply actual values for local development.
# WARNING: NEVER commit or push your .env file containing real credentials!
# ==============================================================================

# -------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
MONGODB_USERNAME=novelforge
MONGODB_PASSWORD=replace_with_a_long_random_password
MONGODB_HOST_PORT=27018
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_postgres_password_here

# -------------------------------------------------------------
# Redis Cache & Sessions
# -------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------------------------------------------
# RabbitMQ (local Docker Compose)
# Use a non-guest account because services connect over the Docker network.
# -------------------------------------------------------------
RABBITMQ_USERNAME=novelforge
RABBITMQ_PASSWORD=replace_with_a_long_random_local_password

# -------------------------------------------------------------
# Internal service authentication and OTP verification
# Keep these values private. Generate independent random values of 32+ bytes.
# -------------------------------------------------------------
IDENTITY_INTERNAL_CLIENT_SECRET=replace_with_a_long_random_internal_secret
OTP_HMAC_SECRET=replace_with_a_different_long_random_otp_hmac_secret
GATEWAY_INTERNAL_SECRET=replace_with_a_separate_long_random_gateway_secret
GATEWAY_TRUSTED_PROXY_HOPS=0
COOKIE_SECURE=false

# -------------------------------------------------------------
# JWT Authentication & Security
# Minimum 256-bit secret string for HMAC-SHA256 signing
# -------------------------------------------------------------
JWT_SECRET_KEY=your_secure_jwt_secret_key_at_least_256_bits_long
NOVELFORGE_SECURITY_JWT_SECRET_KEY=your_secure_jwt_secret_key_at_least_256_bits_long

# -------------------------------------------------------------
# Notification Service (Email & OTP)
# Option A: Brevo API (Recommended)
# -------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender_email@example.com
NOTIFICATION_EMAIL_PROVIDER=smtp
NOTIFICATION_EMAIL_FROM=notifications@novelforge.local

# Option B: SMTP Credentials
SPRING_MAIL_USERNAME=your_smtp_username_here
SPRING_MAIL_PASSWORD=your_smtp_app_password_here

# -------------------------------------------------------------
# Service Discovery & Gateway Endpoints
# -------------------------------------------------------------
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
IDENTITY_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8082
NOVEL_SERVICE_URL=http://localhost:8083

# -------------------------------------------------------------
# Frontend Client
# -------------------------------------------------------------
VITE_API_URL=http://localhost:8080
