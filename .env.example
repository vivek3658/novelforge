# Copy to .env for local development. Do not commit .env.
# Use the same JWT secret for Identity and Studio.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password
IDENTITY_DB=userDB
STUDIO_DB=studioDB

# Redis running in WSL Ubuntu, reachable from Windows through localhost.
REDIS_HOST=localhost
REDIS_PORT=6379

IDENTITY_PORT=8081
STUDIO_PORT=8087
IDENTITY_SERVICE_BASE_URL=http://localhost:8081

# Use the same generated value for Identity and Studio.
IDENTITY_INTERNAL_CLIENT_SECRET=replace-with-a-random-internal-service-secret

EUREKA_URL=http://localhost:8761/eureka/
NOTIFICATION_SERVICE_URL=http://localhost:8082
