# ==============================================================================
# Notification Service - Production Environment Template (.env.production.example)
# Render Free Tier Specs: 0.1 vCPU / 512MB RAM
# ==============================================================================
PORT=8082
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms64m -Xmx160m -XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=32m -Xss256k -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# Redis (Render Managed Key-Value Store)
REDIS_URL=redis://default:password@novelforge-redis:6379
SPRING_DATA_REDIS_HOST=novelforge-redis
SPRING_DATA_REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=novelforge-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=novelforge
RABBITMQ_PASSWORD=replace_with_rabbitmq_password

# Identity Service Endpoint & Internal Secret
IDENTITY_SERVICE_URL=http://novelforge-identity-service:8081
NOTIFICATION_IDENTITY_INTERNAL_SECRET=replace_with_notification_identity_secret_32bytes_min

# Email Provider Configuration (Brevo Recommended for Render)
NOTIFICATION_EMAIL_PROVIDER=brevo
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=notifications@yourdomain.com
NOTIFICATION_EMAIL_FROM=notifications@yourdomain.com

# SMTP Fallback (e.g. Gmail / SendGrid / Postmark SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_smtp_app_password

# Service Discovery (Eureka)
EUREKA_CLIENT_ENABLED=true
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://novelforge-eureka-server:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
